---
/**
 * Baner zgody na cookies i modal ustawien.
 *
 * Wymogi ponizej nie sa preferencjami wizualnymi, tylko warunkami waznosci
 * zgody. Zlamanie ktoregokolwiek sprawia, ze zgoda jest wadliwa, a wiec ze
 * pomiar dziala bez podstawy prawnej:
 *
 * - "Akceptuje wszystkie" i "Tylko niezbedne" musza wygladac tak samo. Nierowna
 *   waga przyciskow to dark pattern. Dlatego oba dziela klase .lpc-btn-primary
 *   i to NIE jest przeoczenie w stylach.
 * - Zaden przelacznik opcjonalny nie moze byc zaznaczony domyslnie - art. 7
 *   RODO, motyw 32: pola zaznaczone z gory nie stanowia zgody.
 * - Odrzucenie musi byc jednym kliknieciem, dokladnie tak jak akceptacja.
 * - Baner jest paskiem u dolu, nie cookie wallem. Zgoda wymuszona dostepem do
 *   tresci nie jest dobrowolna, a wiec nie jest zgoda.
 *
 * Dostepnosc: modal ma role="dialog" i aria-modal, pulapke focusa, Escape
 * zamyka, focus wraca na element, ktory modal otworzyl.
 *
 * Markup wychodzi z serwera z atrybutem `hidden`, a skrypt tylko go odslania.
 * Wzorzec z aitomate.pl buduje baner w JS po DOMContentLoaded i przez to
 * migocze - tego nie powielamy.
 *
 * Polityka prywatnosci jest WSPOLNA dla wszystkich serwisow autora i stoi na
 * aitomate.pl - ten sam adres, ktory podaje `src/config/newsletter.ts`.
 */
import { NEWSLETTER } from '../config/newsletter';
---

<div id="lpc-consent" hidden>
	{/*
	  Przyciemnienie tresci na czas decyzji.

	  TO NIE JEST COOKIE WALL i granica jest tu istotna, nie stylistyczna.
	  Cookie wall znaczy "zgodz sie albo nie wejdziesz" - taka zgoda nie jest
	  dobrowolna, wiec jest niewazna (EROD, wytyczne 05/2020). Tutaj wymuszamy
	  DECYZJE, nie ZGODE: klikniecie "Tylko niezbedne" natychmiast odslania cala
	  strone i niczego nie ogranicza.

	  Warunek, ktorego NIE WOLNO zlamac przy nastepnej edycji: nakladka nie moze
	  znikac po kliknieciu w nia sama. Gdyby znikala, dawaloby to trzecie wyjscie
	  "zamknij bez decyzji", ktore w praktyce jest cichym odrzuceniem - a takiego
	  wyboru nie da sie wykazac.
	*/}
	<div class="lpc-backdrop" id="lpc-backdrop" hidden></div>
	<div
		class="lpc-bar"
		id="lpc-bar"
		role="dialog"
		aria-modal="true"
		aria-label="Zgoda na pliki cookies"
		hidden
	>
		<div class="lpc-bar-text">
			<p class="lpc-bar-title">Pliki cookies</p>
			<p>
				Analityka i marketing ruszają tylko za Twoją zgodą. Bez niej działa wyłącznie to,
				co jest niezbędne, żeby strona się otworzyła. Szczegóły opisuje
				<a href={NEWSLETTER.privacyUrl} rel="noopener noreferrer" target="_blank">
					Polityka prywatności
				</a>.
			</p>
		</div>
		<div class="lpc-bar-actions">
			<button type="button" class="lpc-btn lpc-btn-primary" data-lpc="accept-all">
				Akceptuję wszystkie
			</button>
			<button type="button" class="lpc-btn lpc-btn-primary" data-lpc="reject-all">
				Tylko niezbędne
			</button>
			<button type="button" class="lpc-btn lpc-btn-ghost" data-lpc="customize">
				Ustawienia
			</button>
		</div>
	</div>

	<div class="lpc-modal" id="lpc-modal" hidden>
		<div class="lpc-overlay" data-lpc="close"></div>
		<div
			class="lpc-dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="lpc-modal-title"
		>
			<div class="lpc-dialog-head">
				<h2 id="lpc-modal-title">Ustawienia plików cookies</h2>
				<button type="button" class="lpc-close" data-lpc="close" aria-label="Zamknij">
					&times;
				</button>
			</div>

			<div class="lpc-dialog-body">
				<div class="lpc-group">
					<label class="lpc-group-head">
						<input type="checkbox" checked disabled />
						<span>Niezbędne</span>
					</label>
					<p>
						Zapamiętanie wybranego motywu, Twojej decyzji o cookies oraz strona zastępcza
						na czas braku sieci. Bez tego strona nie działa poprawnie, więc zgoda nie
						jest wymagana.
					</p>
				</div>

				<div class="lpc-group">
					<label class="lpc-group-head">
						<input type="checkbox" id="lpc-analytics" />
						<span>Analityczne</span>
					</label>
					<p>
						Google Analytics 4: liczba odwiedzin, popularność podstron, źródła wejścia,
						typ urządzenia.
					</p>
				</div>

				<div class="lpc-group">
					<label class="lpc-group-head">
						<input type="checkbox" id="lpc-marketing" />
						<span>Marketingowe</span>
					</label>
					<p>
						Pomiar skuteczności reklam i remarketing w usługach Google. Uruchomi się
						dopiero, gdy ruszą kampanie - dziś ta zgoda nic nie włącza.
					</p>
				</div>
			</div>

			<div class="lpc-dialog-foot">
				<button type="button" class="lpc-btn lpc-btn-primary" data-lpc="save">
					Zapisz ustawienia
				</button>
				<button type="button" class="lpc-btn lpc-btn-ghost" data-lpc="close">
					Anuluj
				</button>
			</div>
		</div>
	</div>
</div>

<style>
	#lpc-consent {
		--lpc-z: 120;
	}

	/*
	  Atrybut `hidden` przegladarka realizuje regula `display: none` o
	  specyficznosci selektora typu, wiec KAZDY nasz `display` z selektora
	  klasowego by ja przebil i element zostalby widoczny mimo `hidden`.
	  Bez tej reguly modal otwiera sie razem z banerem przy pierwszej wizycie.
	  Zlapane na kursn8n.pl w podgladzie lokalnym przed wdrozeniem.
	*/
	#lpc-consent[hidden],
	.lpc-bar[hidden],
	.lpc-backdrop[hidden],
	.lpc-modal[hidden] {
		display: none !important;
	}

	/*
	  Przyciemnienie tresci na czas decyzji - patrz komentarz przy markupie.
	  Nakladka przechwytuje klikniecia (brak `pointer-events: none`), ale NIE
	  blokuje przewijania: tresc pozostaje czytelna pod spodem. To swiadomy
	  wybor - im mniej strona przypomina sciane, tym dalej jest od konstrukcji,
	  ktora organy kwestionuja.
	*/
	.lpc-backdrop {
		position: fixed;
		inset: 0;
		z-index: calc(var(--lpc-z) - 1);
		background: rgb(0 0 0 / 50%);
		animation: lpc-fade 0.25s ease-out;
	}

	.lpc-bar {
		position: fixed;
		inset-inline: 0;
		bottom: 0;
		z-index: var(--lpc-z);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		border-top: 1px solid var(--sl-color-hairline);
		box-shadow: 0 -2px 12px rgb(0 0 0 / 25%);
		animation: lpc-slide 0.25s ease-out;
	}

	.lpc-bar-text {
		flex: 1 1 22rem;
		font-size: var(--sl-text-sm);
	}

	.lpc-bar-text p {
		margin: 0;
	}

	.lpc-bar-text a {
		color: var(--sl-color-accent-high);
	}

	.lpc-bar-title {
		font-weight: 600;
		color: var(--sl-color-white);
		margin-bottom: 0.25rem !important;
	}

	.lpc-bar-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.lpc-btn {
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
		padding: 0.55rem 1.1rem;
		border-radius: 0.375rem;
		border: 1px solid transparent;
		white-space: nowrap;
	}

	/*
	  Akceptacja i odrzucenie dziela JEDNA klase i maja identyczny wyglad.
	  To nie jest przeoczenie w stylach - to warunek waznosci zgody.
	*/
	.lpc-btn-primary {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}

	.lpc-btn-primary:hover {
		background: var(--sl-color-accent-high);
	}

	.lpc-btn-ghost {
		background: transparent;
		color: inherit;
		border-color: var(--sl-color-hairline-light);
	}

	.lpc-btn:focus-visible,
	.lpc-close:focus-visible {
		outline: 3px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.lpc-modal {
		position: fixed;
		inset: 0;
		z-index: calc(var(--lpc-z) + 1);
		display: grid;
		place-items: center;
		padding: 1rem;
	}

	.lpc-overlay {
		position: absolute;
		inset: 0;
		background: var(--sl-color-backdrop-overlay);
	}

	.lpc-dialog {
		position: relative;
		width: min(34rem, 100%);
		max-height: 85vh;
		overflow-y: auto;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-2);
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.625rem;
		box-shadow: 0 10px 40px rgb(0 0 0 / 35%);
		padding: 1.25rem;
	}

	.lpc-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.lpc-dialog-head h2 {
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
		margin: 0;
	}

	.lpc-close {
		font: inherit;
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		background: transparent;
		border: 0;
		color: inherit;
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
	}

	.lpc-group {
		padding: 0.9rem 0;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-sm);
	}

	.lpc-group p {
		margin: 0.35rem 0 0 1.65rem;
		color: var(--sl-color-gray-3);
	}

	.lpc-group-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 600;
		color: var(--sl-color-white);
		cursor: pointer;
	}

	.lpc-group-head input[disabled] {
		cursor: not-allowed;
	}

	.lpc-dialog-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	@keyframes lpc-slide {
		from {
			transform: translateY(100%);
		}
		to {
			transform: translateY(0);
		}
	}

	@keyframes lpc-fade {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lpc-bar,
		.lpc-backdrop {
			animation: none;
		}
	}

	/*
	  TELEFON. Pierwsza wersja tego komponentu nie miala breakpointu szerokosci
	  w ogole - pasek dziedziczyl uklad z desktopu, wiec na waskim ekranie tekst
	  i trzy przyciski zawijaly sie w poszarpany blok.

	  Pomiar tego samego banera przy 390 px (wersja dla domen PHP): "Akceptuje
	  wszystkie" 173 px i "Tylko niezbedne" 145 px w pierwszym rzedzie,
	  "Ustawienia" 110 px spychane do drugiego; caly pasek 242 px, czyli 28%
	  ekranu; przyciski 36 px wysokosci, ponizej progu 44 px dla celu dotykowego
	  (WCAG 2.5.5 oraz wytyczne Apple i Google).

	  Rozwiazanie: SIATKA dwukolumnowa zamiast zawijanego rzedu. Akceptacja
	  i odrzucenie stoja obok siebie w kolumnach `1fr 1fr`, wiec maja identyczna
	  szerokosc NIEZALEZNIE od dlugosci tekstu - mocniejsza gwarancja rownej
	  wagi niz flex, gdzie kazdy przycisk dostawal szerokosc od swojej tresci.
	  "Ustawienia" schodzi pod nie na cala szerokosc.

	  Zmierzone po zmianie (390 px): pasek 216 px zamiast 242, oba glowne
	  przyciski 175x44. Na 320 px tekst zawija sie w dwie linie, ale OBA rosna
	  tak samo (140x53) i nic nie wychodzi poza ekran.

	  Zestaw jest celowo taki sam jak w `assets/css/consent.css` na domenach
	  PHP - jeden baner ma wygladac tak samo w calym ekosystemie.
	*/
	@media (max-width: 640px) {
		.lpc-bar {
			flex-direction: column;
			align-items: stretch;
			gap: 0.625rem;
			/* env() chroni przed paskiem gestow iPhone'a. */
			padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
			max-height: 70vh;
			overflow-y: auto;
			overscroll-behavior: contain;
		}

		.lpc-bar-text {
			flex: none;
			font-size: var(--sl-text-xs);
		}

		.lpc-bar-actions {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.5rem;
		}

		.lpc-btn {
			width: 100%;
			min-height: 44px;
			padding-inline: 0.5rem;
			/* Tekst ma sie zawinac, a nie rozepchnac przycisku poza siatke.
			   Oba glowne rosna wtedy rowno, bo dziela kolumne 1fr. */
			white-space: normal;
		}

		/* Trzecia opcja pod spodem, przez cala szerokosc siatki. */
		.lpc-bar-actions .lpc-btn-ghost {
			grid-column: 1 / -1;
		}

		.lpc-modal {
			padding: 0.75rem;
		}

		.lpc-dialog {
			/* 100dvh zamiast 100vh - pasek adresu na mobilnych przegladarkach
			   zmienia wysokosc widoku i przy 100vh modal wystaje poza ekran. */
			max-height: min(85vh, 100dvh - 1.5rem);
			padding: 1rem;
			overscroll-behavior: contain;
		}

		.lpc-dialog-foot {
			flex-direction: column;
		}

		.lpc-dialog-foot .lpc-btn {
			width: 100%;
		}

		/* Wciecie opisu pod checkboxem zjada na telefonie za duzo szerokosci. */
		.lpc-group p {
			margin-left: 0;
		}
	}
</style>

<script>
	import { applyConsent, readConsent, writeConsent } from '../lib/consent';

	const root = document.getElementById('lpc-consent');
	const bar = document.getElementById('lpc-bar');
	const backdrop = document.getElementById('lpc-backdrop');
	const modal = document.getElementById('lpc-modal');
	const analyticsBox = document.getElementById('lpc-analytics') as HTMLInputElement | null;
	const marketingBox = document.getElementById('lpc-marketing') as HTMLInputElement | null;

	if (root && bar && backdrop && modal && analyticsBox && marketingBox) {
		/** Element, ktory otworzyl modal - focus do niego wraca po zamknieciu. */
		let opener: HTMLElement | null = null;

		const focusableIn = (el: HTMLElement) =>
			Array.from(
				el.querySelectorAll<HTMLElement>(
					'button, [href], input:not([disabled]), [tabindex]:not([tabindex="-1"])',
				),
			).filter((node) => node.offsetParent !== null);

		const showBar = () => {
			root.hidden = false;
			bar.hidden = false;
			backdrop.hidden = false;
		};

		const openModal = (trigger: HTMLElement | null) => {
			opener = trigger;
			const saved = readConsent();
			analyticsBox.checked = saved?.analytics ?? false;
			marketingBox.checked = saved?.marketing ?? false;
			root.hidden = false;
			// Modal ma wlasne przyciemnienie (.lpc-overlay), wiec nakladka paska
			// schodzi - inaczej naklada sie ciemne na ciemne.
			backdrop.hidden = true;
			modal.hidden = false;
			focusableIn(modal)[0]?.focus();
		};

		/**
		 * Zamkniecie modalu bez decyzji. Jesli decyzji nadal nie ma, baner musi
		 * wrocic - inaczej "Anuluj" bylby cichym sposobem na pozbycie sie pytania.
		 */
		const dismissModal = () => {
			modal.hidden = true;
			opener?.focus();
			opener = null;
			if (readConsent()) {
				root.hidden = true;
				backdrop.hidden = true;
			} else {
				// Nadal brak decyzji - pasek i przyciemnienie wracaja.
				showBar();
			}
		};

		const decide = (analytics: boolean, marketing: boolean) => {
			const choice = { analytics, marketing };
			writeConsent(choice);
			applyConsent(choice);
			modal.hidden = true;
			bar.hidden = true;
			backdrop.hidden = true;
			root.hidden = true;
		};

		root.addEventListener('click', (event) => {
			const target = (event.target as HTMLElement).closest<HTMLElement>('[data-lpc]');
			if (!target) return;
			switch (target.dataset.lpc) {
				case 'accept-all':
					decide(true, true);
					break;
				case 'reject-all':
					decide(false, false);
					break;
				case 'customize':
					bar.hidden = true;
					openModal(target);
					break;
				case 'save':
					decide(analyticsBox.checked, marketingBox.checked);
					break;
				case 'close':
					dismissModal();
					break;
			}
		});

		/*
		  Pulapka focusa na PASKU. Skoro nakladka odcina tresc od myszy, Tab tez
		  nie moze z niej uciec - inaczej osoba korzystajaca z klawiatury wpada
		  w obszar, ktorego nie widzi i nie moze kliknac.

		  Escape celowo NIE zamyka paska: nie ma decyzji do zapisania, a ciche
		  znikniecie banera byloby trzecim wyjsciem, ktorego nie da sie wykazac.
		*/
		bar.addEventListener('keydown', (event) => {
			if (event.key !== 'Tab') return;
			const items = focusableIn(bar);
			if (items.length === 0) return;
			const first = items[0];
			const last = items[items.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		// Pulapka focusa i Escape - modal musi dac sie obsluzyc sama klawiatura.
		modal.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				event.preventDefault();
				dismissModal();
				return;
			}
			if (event.key !== 'Tab') return;
			const items = focusableIn(modal);
			if (items.length === 0) return;
			const first = items[0];
			const last = items[items.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		// Link "Ustawienia cookies" w stopce wola to zdarzenie.
		window.addEventListener('lp:open-consent', () => {
			bar.hidden = true;
			openModal(document.activeElement as HTMLElement | null);
		});

		// Bootstrap w <head> ustawil juz `consent default` na podstawie tego
		// samego zapisu, wiec dla goscia z decyzja nie ma tu nic do zrobienia.
		if (!readConsent()) showBar();
	}
</script>
