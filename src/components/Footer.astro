---
import Default from '@astrojs/starlight/components/Footer.astro';
import Newsletter from './Newsletter.astro';
import { PREFIX_STRON_POWROTU } from '../config/newsletter';

// Zapis na newsletter pod każdym artykułem - w momencie, gdy czytelnik
// właśnie skończył czytać. Wyjątki:
//   - strona główna ma własną, szerszą sekcję wstawioną wprost w index.mdx,
//     więc tutaj byłaby duplikatem (dwa formularze na jednej stronie to też
//     dwa pola o tym samym `id`, czyli błąd dostępności),
//   - 404 nie jest treścią, na której ktokolwiek kończy lekturę,
//   - strony powrotu z Sendy: człowiek właśnie zapisał się, potwierdził zapis
//     albo się wypisał. Podsuwanie mu wtedy tego samego formularza jest w
//     najlepszym razie bez sensu, a na stronie po wypisaniu wręcz nachalne -
//     ktoś świadomie zrezygnował, więc nie prosimy go od razu z powrotem.
const pathname = Astro.url.pathname;
const pokazNewsletter =
	pathname !== '/' && pathname !== '/404/' && !pathname.startsWith(PREFIX_STRON_POWROTU);
---

<Default><slot /></Default>
{pokazNewsletter && <Newsletter wariant="pasek" />}
<nav class="stopka-prawna" aria-label="Informacje prawne">
	<a href="https://aitomate.pl/polityka-prywatnosci" rel="noopener noreferrer" target="_blank">
		Polityka prywatności
	</a>
	<span aria-hidden="true">·</span>
	<a href="/zasoby/regulamin/">Regulamin</a>
	<span aria-hidden="true">·</span>
	<a href="/zasoby/kontakt/">Kontakt</a>
</nav>
<p class="made-with-love">
	made with ❤️ by <a href="https://aitomate.pl">aitomate.pl</a> - Łukasz Podgórski
</p>

<style>
	/* Odnośniki prawne. Polityka prywatności jest wspólna dla wszystkich
	   serwisów autora i utrzymywana na aitomate.pl (patrz komentarz
	   w src/config/newsletter.ts) - dlatego wychodzi poza domenę. Regulamin
	   jest tutejszy: opisuje ten serwis i ten newsletter, i to on niesie
	   dane firmy, które wcześniej stały na stronie kontaktu. */
	.stopka-prawna {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.stopka-prawna a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.stopka-prawna a:hover,
	.stopka-prawna a:focus-visible {
		color: var(--sl-color-white);
		text-decoration: underline;
	}

	.made-with-love {
		margin: 0.4rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.made-with-love a {
		color: var(--sl-color-gray-2);
	}
	.made-with-love a:hover {
		color: var(--sl-color-white);
	}
</style>
